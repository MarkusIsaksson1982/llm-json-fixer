[{"id": "h-01", "cat": "heldout:markdown-fence-with-prose", "input": "Here are the arguments you asked for:\n\n```json\n{\"path\": \"src/index.js\", \"encoding\": \"utf-8\"}\n```\n\nLet me know if you need anything else.", "expect": [{"path": "src/index.js", "encoding": "utf-8"}], "schema": null, "valid": null}, {"id": "h-02", "cat": "heldout:markdown-fence-with-prose-toolcall", "input": "Sure! I'll create the file now.\n\n```\n{\"tool\": \"write_file\", \"arguments\": {\"filename\": \"a.txt\", \"content\": \"hello\"}}\n```\nDone — the file has been written.", "expect": [{"tool": "write_file", "arguments": {"filename": "a.txt", "content": "hello"}}], "schema": null, "valid": null}, {"id": "h-03", "cat": "heldout:markdown-fence-array", "input": "The search returned 2 documents:\n```json\n[{\"id\": 1, \"title\": \"Alpha\"}, {\"id\": 2, \"title\": \"Beta\"}]\n```", "expect": [[{"id": 1, "title": "Alpha"}, {"id": 2, "title": "Beta"}]], "schema": null, "valid": null}, {"id": "h-04", "cat": "heldout:trailing-comma", "input": "{\"a\": 1, \"b\": 2, \"c\": [3, 4,], \"d\": {\"e\": 5,},}", "expect": [{"a": 1, "b": 2, "c": [3, 4], "d": {"e": 5}}], "schema": null, "valid": null}, {"id": "h-05", "cat": "heldout:trailing-comma-nested", "input": "{\"servers\": [{\"host\": \"a\"}, {\"host\": \"b\"},],}", "expect": [{"servers": [{"host": "a"}, {"host": "b"}]}], "schema": null, "valid": null}, {"id": "h-06", "cat": "heldout:python-literals-single-quotes", "input": "{'name': 'Ada Lovelace', 'roles': ['admin', 'dev'], 'active': True}", "expect": [{"name": "Ada Lovelace", "roles": ["admin", "dev"], "active": true}], "schema": null, "valid": null}, {"id": "h-07", "cat": "heldout:python-literals-none-false", "input": "{'status': 'ok', 'value': None, 'items': [], 'meta': {'retries': 0, 'verbose': False}}", "expect": [{"status": "ok", "value": null, "items": [], "meta": {"retries": 0, "verbose": false}}], "schema": null, "valid": null}, {"id": "h-08", "cat": "heldout:unquoted-keys", "input":